# PostgreSQL connection used by the app container.
DATABASE_URL=postgresql://library:library_password@postgres:5432/library

# Local app data volume path inside the container.
APP_DATA_DIR=/data

# Public URL used for generated links and local callbacks.
APP_BASE_URL=http://localhost:3000

# Optional contact identifier for metadata provider requests.
APP_CONTACT_EMAIL=local-use@cozy-library.invalid

# Optional metadata provider keys. Leave blank if unused.
GOOGLE_BOOKS_API_KEY=
ISBNDB_API_KEY=
HARDCOVER_API_TOKEN=
HARDCOVER_API_TOKEN_FILE=

# Enable upload-based OCR scanning.
ENABLE_OCR=true

# Seed removable demo books on startup when they are missing.
# Real libraries should use false. Demo installs can use true.
DEMO_CATALOG=false
# Advanced override, if needed: skip | ensure | seed | clear.
# DEMO_CATALOG_MODE=skip

# One-time NAS recovery switch for old non-empty databases without Prisma migration history.
# Keep false by default. Set true only after backing up, start once, then set back to false.
ALLOW_LEGACY_DATABASE_UPGRADE=false
